# Google OAuth (local Supabase only — also enable Google in the hosted project dashboard)
# Create a Web client at https://console.cloud.google.com/auth/clients
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# API key for AI preparation
DEEPSEEK_API_KEY=

# Billing (Stripe sandbox)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# "11s Pro" prices already created in the sandbox ($8/mo and $80/yr)
STRIPE_PRO_MONTHLY_PRICE_ID=price_1U2CmnIgktTwioD57USRMihk
STRIPE_PRO_YEARLY_PRICE_ID=price_1U2CmoIgktTwioD5lEeUnCXm

# Public base URL of the app, e.g. https://11s.app (used for billing redirects)
NEXT_PUBLIC_APP_URL=
