NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side key for the billing webhook (never expose to the browser)
SUPABASE_SECRET_KEY=

# Google OAuth (local Supabase only — also enable Google in the hosted project dashboard)
# Create a Web client at https://console.cloud.google.com/auth/clients
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# API key for AI preparation
DEEPSEEK_API_KEY=

# Billing (Stripe sandbox)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# "11s Pro" prices already created in the sandbox ($5/mo, $13/3mo, $50/yr)
STRIPE_PRO_MONTHLY_PRICE_ID=price_1U4aq2IgktTwioD51sHedyMM
STRIPE_PRO_QUARTERLY_PRICE_ID=price_1U4appIgktTwioD5wOMq2yhs
STRIPE_PRO_YEARLY_PRICE_ID=price_1U4aq2IgktTwioD5Hr6iK6KU

# Telegram operator notifications (new signups, subscription events)
# Create a bot via @BotFather, then get the chat id of your ops channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public base URL of the app, e.g. https://11s.app (used for billing redirects)
NEXT_PUBLIC_APP_URL=
